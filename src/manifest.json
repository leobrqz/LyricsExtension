{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.4.0",
  "default_locale": "en",
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "background": { "scripts": ["background.js"] },
  "permissions": ["menus", "storage", "activeTab"],
  "host_permissions": [
    "https://api.lyrics.ovh/*",
    "https://www.letras.mus.br/*",
    "https://letras.mus.br/*"
  ],
  "optional_host_permissions": [
    "https://api.mymemory.translated.net/*",
    "https://bergamot.s3.amazonaws.com/*",
    "https://storage.googleapis.com/moz-fx-translations-data--303e-prod-translations-data/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; frame-src 'none'; connect-src 'self' https://api.lyrics.ovh https://www.letras.mus.br https://letras.mus.br https://api.mymemory.translated.net https://bergamot.s3.amazonaws.com https://storage.googleapis.com/moz-fx-translations-data--303e-prod-translations-data/; img-src 'self' data:"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lyrics-extension@leobrqz.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["searchTerms", "websiteContent"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  }
}
